<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 角落悬浮窗需要的「显示在其他应用上层」权限，由用户手动授权。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 轮盘菜单划过图标时的触感反馈。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Shizuku 授权通道。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 枚举所有已安装应用（用于检测图标包、应用列表）。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 「更多」面板「最近使用」读系统应用使用记录（见 RecentUsage）。
         这是 Android 的「使用情况访问」特殊权限：**写进 manifest 不会自动生效**，
         必须在系统设置里由用户手动打开；没开就自动退回「本应用观测到的前台应用」。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 开机自启：系统重启后自动恢复 Shizuku 监听与主动呼出服务。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 「关于」页的「检查更新」要访问 GitHub 的 releases 接口。这是全应用唯一一处联网，
         且只在用户主动点「检查更新」时发生，不涉及任何数据上传。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 「扫一扫 / 付款码」要按 scheme 拉起微信、支付宝。声明出来才能解析到对方。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
        <!--
          识屏：
          - **首选路要这条可见性声明。** 「侧边栏功能 URI」是把 Intent 交给
            `com.coloros.smartsidebar` 去执行，我们要在本进程里 `resolveActivity` 判它认不认
            这个 scheme（ColorOS 17 已移除，16 及更早才有）。Android 11+ 的包可见性会把没声明的
            包过滤掉，不声明的话 `resolveActivity` 恒为 null —— 那就会「明明系统里有入口，
            却每次都退回兜底手势」。
          - 兜底路（重放双指长按）是纯无障碍注入，不涉及解析别人的组件，不需要声明。
        -->
        <package android:name="com.coloros.smartsidebar" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlymeFreeformNoRoot">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 应用管理单独成页：应用列表太长，放设置主页会把后面的设置项顶到很远。 -->
        <activity
            android:name=".AppManagementActivity"
            android:exported="false"
            android:label="@string/app_management_title" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="运行日志" />

        <activity
            android:name=".CornerSettingsActivity"
            android:exported="false"
            android:label="主动呼出" />

        <activity
            android:name=".OutsideTapSettingsActivity"
            android:exported="false"
            android:label="小窗关闭方式" />

        <!-- 小窗尺寸：只有 AOSP 形态（小米 / vivo）才有的入口，ColorOS 由系统自己定大小。
             页面里还带「大小校准」（仅小米），所以不再单独开一页。 -->
        <activity
            android:name=".FreeformSizeActivity"
            android:exported="false"
            android:label="小窗尺寸" />

        <!-- 「更多」面板的行为参数（默认页 / 工具顺序 / 底栏沉底）。 -->
        <activity
            android:name=".DrawerSettingsActivity"
            android:exported="false"
            android:label="更多面板" />

        <!-- 触感（振动）：总开关 + 轮盘 / 面板切页 / 长按 / 索引四处开关。 -->
        <activity
            android:name=".HapticSettingsActivity"
            android:exported="false"
            android:label="触感" />

        <!-- 图标：来源选择 + 「默认 vs 当前来源」的对比预览。 -->
        <activity
            android:name=".IconSettingsActivity"
            android:exported="false"
            android:label="图标" />

        <!-- 关于：版本 / 主页 + 更新与下载（自动更新、检查更新、更新日志、下载链接）。 -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于" />

        <service
            android:name=".OverlayGestureService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="corner_gesture_overlay" />
        </service>

        <!-- 窗外点击关闭：靠无障碍拿窗口边界 + 铺点击接收层，替代 Hook system_server。 -->
        <service
            android:name=".FreeformAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/freeform_accessibility_service" />
        </service>

        <!-- 通知栏快捷磁贴：一键看状态 / 用 Shizuku 把无障碍写回来（重启后权限被系统清掉时用）。
             磁贴自己**没有权限**开关无障碍（那是 WRITE_SECURE_SETTINGS 保护的系统设置），
             只能借 Shizuku 的 shell 身份去写。 -->
        <service
            android:name=".FreeformTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="免root小窗"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 开机 / 应用更新后自动恢复：挂 Shizuku 重连监听 + 服务开着就拉起来。 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 应用安装/卸载时通知服务刷新「更多」面板的应用列表。 -->
        <receiver
            android:name=".PackageEventsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 「一键锁屏」的设备管理入口。只申请 force-lock，用户需手动激活一次。 -->
        <receiver
            android:name=".LockScreenAdmin"
            android:enabled="true"
            android:exported="true"
            android:label="@string/lock_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  「一键锁屏」工具的图形：一把挂锁。

  路径来源：Lucide `lock`（ISC License，见 NOTICE.md）
    https://cdn.jsdelivr.net/npm/lucide-static/icons/lock.svg
  ★ 是**描边（stroke）**而不是填充：Lucide 是线性图标库，path 只描述中心线。
    别把这些 path 改成 fillColor 填实 —— 那是另一种观感（实心块，2026-10-08 前几版就是这么做的，
    用户否掉：「不像一个现代软件功能该有的样子」）。circle/rect 已由脚本折成等价的 path。

  外面这层 <group> 把中心线缩放到「外接圆半径 = 10.0 - 线宽/2」，再摆到画布正中：
    scale = 0.7227     平移 (+3.328,+3.328) → 中心线外接圆中心落在 (12,12)
    strokeWidth = 2.3524   ← 反算过的值，为的是**六个图标在真机上线宽一模一样**
                              （线宽也吃 scale，直接写 1.7 会变成一粗一细）

  圆底是内切圆（半径 12），内容含描边的最外沿恰好 10.0，四周留 1.8 呼吸，永不戳出圆边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.7227"
        android:scaleY="0.7227"
        android:translateX="3.3279"
        android:translateY="3.3279">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.3524"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M5.0,11.0h14.0a2.0,2.0 0 0 1 2.0,2.0v7.0a2.0,2.0 0 0 1 -2.0,2.0h-14.0a2.0,2.0 0 0 1 -2.0,-2.0v-7.0a2.0,2.0 0 0 1 2.0,-2.0Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.3524"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M7 11V7a5 5 0 0 1 10 0v4" />
</group>
</vector>
